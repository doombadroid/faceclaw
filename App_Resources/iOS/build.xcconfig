// 26.4: the translation work uses iOS 26.4's Translation strategies (FluidAudio, the Parakeet
// speech model in nativescript.config.ts, needs only 17). Podfile and the CI build's command-line
// override must say the same.
IPHONEOS_DEPLOYMENT_TARGET = 26.4;
TARGETED_DEVICE_FAMILY = 1;
CODE_SIGN_STYLE = Automatic;

// Set IOS_TEAM_ID in build_paths.sh (or pass --teamId) to choose the signing team.
OTHER_LDFLAGS = $(inherited) -framework CoreBluetooth -framework CoreLocation -framework CoreText -framework Speech -framework AVFoundation -framework WebKit -framework UniformTypeIdentifiers -framework ImageIO -framework EventKit -framework Network -framework CoreMedia -framework CoreVideo -framework QuartzCore -framework UserNotifications -framework NaturalLanguage -framework Translation -framework Accelerate -lsqlite3 -lc++ -framework CoreML -weak_framework AlarmKit

// Language mode for src/*.swift (the runtime template says 4.2). ns build passes SWIFT_ENABLE_EXPLICIT_MODULES=NO
// unless this file sets it; CI calls xcodebuild directly, so set it here too.
// AlarmKit is weak-linked above from when the minimum was iOS 17; harmless at 26.4.
SWIFT_VERSION = 5.0;
SWIFT_ENABLE_EXPLICIT_MODULES = NO;

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon;

HEADER_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../../App_Resources/iOS/src/lc3"
// NativeScript's xcconfig merge keeps only the CocoaPods HEADER_SEARCH_PATHS when the
// generated project is rebuilt, so the vendored liblc3 include dir is also passed as a flag
// (OTHER_CFLAGS merges like OTHER_LDFLAGS).
// sherpa-onnx's C API header for FaceclawSherpa.m, staged by scripts/ios-native-deps.cjs outside the
// xcframeworks (whose C++ headers are stripped). CoreML above is for onnxruntime's CoreML provider.
// The ObjC shims implement Kotlin/Native protocols (SqlPort, IosPcmRecognizer, ...) and call
// FaceclawKit by selector; a missed or mangled name (build 37's crash was one, on the JS side)
// is only a warning by default, so make those errors.
OTHER_CFLAGS = $(inherited) -I"$(SRCROOT)/../../App_Resources/iOS/src/lc3" -I"$(SRCROOT)/../../native/kotlin/plugin/platforms/ios/include" -Werror=protocol -Werror=incomplete-implementation -Werror=objc-method-access

// FaceclawKit ships arm64 device and Apple-silicon simulator slices.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64;
