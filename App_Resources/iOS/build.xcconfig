IPHONEOS_DEPLOYMENT_TARGET = 15.1;
TARGETED_DEVICE_FAMILY = 1;
CODE_SIGN_STYLE = Automatic;

// Set IOS_TEAM_ID in build_paths.sh (or pass --teamId) to choose the signing team.
OTHER_LDFLAGS = $(inherited) -framework CoreBluetooth -framework CoreLocation -framework CoreText -framework Speech -framework AVFoundation -framework WebKit -framework UniformTypeIdentifiers -framework ImageIO -framework EventKit -framework Network -framework CoreMedia -framework CoreVideo -framework QuartzCore -framework UserNotifications -framework NaturalLanguage -framework Accelerate -lsqlite3 -lc++ -weak_framework AlarmKit

// Language mode for src/*.swift (the runtime template says 4.2). ns build passes SWIFT_ENABLE_EXPLICIT_MODULES=NO
// unless this file sets it; CI calls xcodebuild directly, so set it here too.
// AlarmKit (iOS 26+) is weak-linked above so iOS 15-25 still launch.
SWIFT_VERSION = 5.0;
SWIFT_ENABLE_EXPLICIT_MODULES = NO;

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon;

HEADER_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../../App_Resources/iOS/src/lc3"
// NativeScript's xcconfig merge keeps only the CocoaPods HEADER_SEARCH_PATHS when the
// generated project is rebuilt, so the vendored liblc3 include dir is also passed as a flag
// (OTHER_CFLAGS merges like OTHER_LDFLAGS).
OTHER_CFLAGS = $(inherited) -I"$(SRCROOT)/../../App_Resources/iOS/src/lc3"

// FaceclawKit ships arm64 device and Apple-silicon simulator slices.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64;
