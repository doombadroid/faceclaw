- (NSString *)readStringFieldValuePb:(FaceclawKitKotlinByteArray *)pb fieldNumber:(int32_t)fieldNumber __attribute__((swift_name("readStringFieldValue(pb:fieldNumber:)")));
- (FaceclawKitBleProtocolVarintResult * _Nullable)readVarintPb:(FaceclawKitKotlinByteArray *)pb offset:(int32_t)offset __attribute__((swift_name("readVarint(pb:offset:)")));
- (int32_t)readVarintFieldValuePb:(FaceclawKitKotlinByteArray *)pb fieldNumber:(int32_t)fieldNumber defaultValue:(int32_t)defaultValue __attribute__((swift_name("readVarintFieldValue(pb:fieldNumber:defaultValue:)")));

/**
 * Split one notification value into individual `aa21`/`aa12` envelope frames. A value
 * normally holds exactly one frame, but the firmware can pack several (each self-describing
 * via the length byte at offset 3), and a frame that only reads the first would silently
 * drop the rest. A value that does not start with an envelope, or a trailing partial frame
 * (truncated by the stack — observed on a Samsung tablet for values over 64 bytes), is
 * returned as-is so the caller can log it.
 */
- (NSMutableArray<FaceclawKitKotlinByteArray *> *)splitFramesValue:(FaceclawKitKotlinByteArray * _Nullable)value __attribute__((swift_name("splitFrames(value:)")));
- (FaceclawKitKotlinByteArray *)stripTrailingCrcPb:(FaceclawKitKotlinByteArray * _Nullable)pb __attribute__((swift_name("stripTrailingCrc(pb:)")));
