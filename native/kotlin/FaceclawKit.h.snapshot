@end


/**
 * The stock-firmware request/reply plumbing that the device-info probe, the flash prompt and
 * the OTA flasher all need on top of a [StockLink]: connect + subscribe, envelope sequence and
 * magic allocation, frame demux, ack matching keyed by (sid, magic), the bond-aware security
 * auth exchange (only the firmware's SUCCESS satisfies it), the unsolicited settings capture,
 * async-event and disconnect hooks, and the OTA ack queue. Blocking calls run on the owning
 * flow's worker thread; notifications arrive on the platform's callback thread.
 */
__attribute__((objc_subclassing_restricted))
__attribute__((swift_name("StockLinkSession")))
@interface FaceclawKitStockLinkSession : FaceclawKitBase <FaceclawKitStockLinkListener>
- (instancetype)initWithLink:(id<FaceclawKitStockLink>)link log:(void (^)(NSString *))log timings:(FaceclawKitStockFlowTimings *)timings magicStart:(int32_t)magicStart magicEnd:(int32_t)magicEnd seqStart:(int32_t)seqStart traceFrames:(BOOL)traceFrames platform:(id<FaceclawKitProtocolPlatform>)platform __attribute__((swift_name("init(link:log:timings:magicStart:magicEnd:seqStart:traceFrames:platform:)"))) __attribute__((objc_designated_initializer));
@property (class, readonly, getter=companion) FaceclawKitStockLinkSessionCompanion *companion __attribute__((swift_name("companion")));
- (int32_t)doAllocMagic __attribute__((swift_name("doAllocMagic()")));

/**
 * Send the sid-0x80 authentication request and wait for the firmware's SUCCESS notification,
 * which only arrives once the link is encrypted. On an unbonded phone that means waiting
 * through the OS pairing flow (BOND_BONDING, possibly with a dialog up), so the wait is
 * extended while the OS reports pairing in progress and the request is re-sent once after a
 * fresh bond in case the pre-pairing write was dropped. Bond state is polled; 250 ms
 * granularity is plenty here. Platforms that cannot see bonding (UNKNOWN) get the plain
 * timeout. The first reply with a non-success result is expected before encryption and does
 * not satisfy the wait.
 */
- (FaceclawKitStockLinkSessionAuthResult *)authenticateAddress:(NSString *)address label:(NSString *)label __attribute__((swift_name("authenticate(address:label:)")));

/** Connect, tune, discover and subscribe to the control notify (plus the OTA notify when asked). Throws on failure. */
- (void)bringUpAddress:(NSString *)address otaChannel:(BOOL)otaChannel __attribute__((swift_name("bringUp(address:otaChannel:)")));

/** Wake every pending wait; subsequent waits return immediately as timeouts. */
- (void)cancel __attribute__((swift_name("cancel()")));
- (void)closeQuietly __attribute__((swift_name("closeQuietly()")));
- (void)disconnectQuietlyAddress:(NSString *)address __attribute__((swift_name("disconnectQuietly(address:)")));
- (BOOL)isConnectedAddress:(NSString *)address __attribute__((swift_name("isConnected(address:)")));
- (int32_t)nextSeq __attribute__((swift_name("nextSeq()")));
- (int64_t)now __attribute__((swift_name("now()")));
- (void)onConnectionStateChangeAddress:(NSString *)address connected_:(BOOL)connected __attribute__((swift_name("onConnectionStateChange(address:connected_:)")));
- (void)onNotificationAddress:(NSString *)address characteristicUuid:(NSString *)characteristicUuid data_:(FaceclawKitKotlinByteArray *)data __attribute__((swift_name("onNotification(address:characteristicUuid:data_:)")));

/** One sid-0x09 settings read; the ack protobuf or null when unanswered. */
- (FaceclawKitKotlinByteArray * _Nullable)readSettingsAddress:(NSString *)address timeoutMs:(int32_t)timeoutMs __attribute__((swift_name("readSettings(address:timeoutMs:)")));
- (void)resetSeqValue:(int32_t)value __attribute__((swift_name("resetSeq(value:)")));

/** Mandatory session prelude on sid=0x01; throws when it is not acked. */
- (void)sendPreludeAddress:(NSString *)address failureDetail:(NSString *)failureDetail __attribute__((swift_name("sendPrelude(address:failureDetail:)")));

/** Block while the OS reports this arm as BONDING (pairing dialog up / SMP in flight). */
- (void)waitForBondToSettleAddress:(NSString *)address label:(NSString *)label sleeper:(FaceclawKitInterruptibleSleep *)sleeper __attribute__((swift_name("waitForBondToSettle(address:label:sleeper:)")));

/**
 * Write a request and wait for the ack carrying the same sid and magic. Returns the ack's
 * protobuf (possibly empty), or null on write failure / timeout / cancel.
 */
- (FaceclawKitKotlinByteArray * _Nullable)writeAndAwaitAckAddress:(NSString *)address sid:(int32_t)sid flag:(int32_t)flag magic:(int32_t)magic payload:(FaceclawKitKotlinByteArray *)payload timeoutMs:(int32_t)timeoutMs __attribute__((swift_name("writeAndAwaitAck(address:sid:flag:magic:payload:timeoutMs:)")));

/** Frame and write one message on the control characteristic; false when the write failed. */
- (BOOL)writeFrameAddress:(NSString *)address sid:(int32_t)sid flag:(int32_t)flag payload:(FaceclawKitKotlinByteArray *)payload __attribute__((swift_name("writeFrame(address:sid:flag:payload:)")));

/** @throws IllegalStateException when the link reports "not connected". */
- (BOOL)writeFrameAddress:(NSString *)address characteristicUuid:(NSString *)characteristicUuid sid:(int32_t)sid flag:(int32_t)flag payload:(FaceclawKitKotlinByteArray *)payload seq:(int32_t)seq __attribute__((swift_name("writeFrame(address:characteristicUuid:sid:flag:payload:seq:)")));
@property (readonly) BOOL cancelled __attribute__((swift_name("cancelled")));
@property void (^ _Nullable onDisconnected)(NSString *) __attribute__((swift_name("onDisconnected")));

/** Async events (flag 0x01/0x06) on the control characteristic, e.g. list selections. */
@property void (^ _Nullable onEvent)(NSString *, FaceclawKitBleProtocolParsedFrame *) __attribute__((swift_name("onEvent")));

/** OTA acks (first two payload bytes: opcode, status) from the data-notify characteristic. */
@property (readonly) FaceclawKitBlockingQueue<FaceclawKitKotlinByteArray *> *otaAcks __attribute__((swift_name("otaAcks")));
@property (readonly) id<FaceclawKitProtocolPlatform> platformServices __attribute__((swift_name("platformServices")));

/** Latest sid-0x09 frame carrying firmware versions, whatever magic it came with. */
@property (readonly) FaceclawKitKotlinByteArray * _Nullable unsolicitedSettingsPb __attribute__((swift_name("unsolicitedSettingsPb")));
@end

