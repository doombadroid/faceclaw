 * enable lives in the glasses' EvenHub session, so a transport drop or a
 * session suspend can leave this session started with a worker that will
 * never see another packet.
 */
- (BOOL)isCapturing __attribute__((swift_name("isCapturing()")));

/** Called from the BLE notification thread for every glasses mic packet. */
- (void)queueAudioPacketData:(FaceclawKitKotlinByteArray * _Nullable)data arm:(NSString * _Nullable)arm arrivalMs:(int64_t)arrivalMs __attribute__((swift_name("queueAudioPacket(data:arm:arrivalMs:)")));
- (void)setBeamFilterEnabled:(BOOL)enabled centerDeg:(int32_t)centerDeg halfWidthDeg:(int32_t)halfWidthDeg __attribute__((swift_name("setBeamFilter(enabled:centerDeg:halfWidthDeg:)")));
- (void)setEndpointingEndpointing:(BOOL)endpointing __attribute__((swift_name("setEndpointing(endpointing:)")));
- (void)setListenerListener:(id<FaceclawKitFaceclawVoiceControllerListener> _Nullable)listener __attribute__((swift_name("setListener(listener:)")));
- (void)setNoiseSuppressionEnabled:(BOOL)enabled __attribute__((swift_name("setNoiseSuppression(enabled:)")));
- (void)setOnboardModelKindKind:(NSString * _Nullable)kind __attribute__((swift_name("setOnboardModelKind(kind:)")));
- (void)setSaveRecordingsSaveRecordings:(BOOL)saveRecordings __attribute__((swift_name("setSaveRecordings(saveRecordings:)")));
