 * composite and its fingerprint (used for background windows). Takes effect when the next frame
 * composites.
 */
- (void)setSurfaceVisibleId:(NSString *)id visible:(BOOL)visible __attribute__((swift_name("setSurfaceVisible(id:visible:)")));

/**
 * Dim every surface whose zOrder is below belowZOrder to factor256/256 of its brightness (256 =
 * no dimming): how a shell overlay that dims what it covers (the TS Layer.dimUnderneath)
 * reaches the window surfaces beneath the shell surface, which the shell's own layer stack
 * cannot paint. Visible pixels stay at least 1 (the color-key black); glyph and firmware-text
 * draws keep their cached-draw form with a dimmed value; image draws leave the composite's draw
 * list (their pixels, already baked into the surface, dim as raster). Takes effect when the
 * next frame composites.
 */
- (void)setUnderlayDimBelowZOrder:(int32_t)belowZOrder factor256:(int32_t)factor256 __attribute__((swift_name("setUnderlayDim(belowZOrder:factor256:)")));

/** Retain pixels without recompositing; iOS coalesces updates before its frame callback. */
- (void)submitSurfaceSurfaceId:(NSString *)surfaceId pixels:(FaceclawKitByteReader *)pixels rectX:(int32_t)rectX rectY:(int32_t)rectY rectWidth:(int32_t)rectWidth rectHeight:(int32_t)rectHeight fingerprint:(NSString *)fingerprint __attribute__((swift_name("submitSurface(surfaceId:pixels:rectX:rectY:rectWidth:rectHeight:fingerprint:)")));

/** Retain the full surface's draw identities along with its already-baked pixels. */
- (void)submitSurfaceSurfaceId:(NSString *)surfaceId pixels:(FaceclawKitByteReader *)pixels rectX:(int32_t)rectX rectY:(int32_t)rectY rectWidth:(int32_t)rectWidth rectHeight:(int32_t)rectHeight fingerprint:(NSString *)fingerprint draws:(FaceclawKitByteReader * _Nullable)draws __attribute__((swift_name("submitSurface(surfaceId:pixels:rectX:rectY:rectWidth:rectHeight:fingerprint:draws:)")));
@end

