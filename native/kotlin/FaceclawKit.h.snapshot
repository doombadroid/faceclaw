/**
 * IMU control (ImuCtrl = field 22 of the main ctx). IMU_CtrlCmd carries IMUReportEn
 * (field 1) and reportFrq (field 2). reportFrq is only meaningful when enabling; on disable
 * we send just the enable flag.
 */
- (FaceclawKitKotlinByteArray *)buildImuControlMagic:(int32_t)magic enable:(BOOL)enable reportFrq:(int32_t)reportFrq __attribute__((swift_name("buildImuControl(magic:enable:reportFrq:)")));

/**
 * Stock settings helper (Faceclaw uses CFW mode 30). autoAdjust and
 * brightnessLevel are oneof alternatives: never encode both. A level
 * alone does NOT disable stock auto adjustment; it is a temporary
 * manual override when auto remains enabled. Stock clamps to 2..100.
 */
- (FaceclawKitKotlinByteArray *)buildSetBrightnessMagic:(int32_t)magic autoAdjust:(BOOL)autoAdjust brightnessLevel:(int32_t)brightnessLevel __attribute__((swift_name("buildSetBrightness(magic:autoAdjust:brightnessLevel:)")));

/** Enable the firmware's wear detector (DeviceReceiveInfoFromAPP field 5). */
- (FaceclawKitKotlinByteArray *)buildSetWearDetectionMagic:(int32_t)magic enabled:(BOOL)enabled __attribute__((swift_name("buildSetWearDetection(magic:enabled:)")));
