@property (class, readonly, getter=companion) FaceclawKitFlashPromptFlowCompanion *companion __attribute__((swift_name("companion")));

/** Abort the prompt (e.g. the user backed out on the phone). */
- (void)cancel __attribute__((swift_name("cancel()")));
- (void)run __attribute__((swift_name("run()")));
@property (readonly) BOOL cancelled __attribute__((swift_name("cancelled")));
@end

