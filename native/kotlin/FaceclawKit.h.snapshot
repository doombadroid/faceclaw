/** One-line stats summary, e.g. for showing in the phone UI. */
- (NSString *)statsSummary __attribute__((swift_name("statsSummary()")));

/** Finish every frame open longer than [FRAME_TIMEOUT_MS] as a timeout; returns how many. */
