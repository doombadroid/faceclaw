- (FaceclawKitKotlinByteArray *)encodeTextObjectName:(NSString *)name containerId:(int32_t)containerId x:(int32_t)x y:(int32_t)y width:(int32_t)width height:(int32_t)height text:(NSString *)text captureEvents:(BOOL)captureEvents __attribute__((swift_name("encodeTextObject(name:containerId:x:y:width:height:text:captureEvents:)")));
- (NSMutableArray<FaceclawKitKotlinByteArray *> *)framePbPb:(FaceclawKitKotlinByteArray *)pb sid:(int32_t)sid flag:(int32_t)flag seq:(int32_t)seq maxWrite:(int32_t)maxWrite __attribute__((swift_name("framePb(pb:sid:flag:seq:maxWrite:)")));

/**
 * True when `pb` (trailing CRC still attached) is the success notification for the
 * authentication request sent with `magic`: command 4, the same magic, and an EMPTY field-3
 * result message (`1a 00` — the omitted result code defaults to zero). A GATT write
 * completing is NOT success; only this notification is.
 */
- (BOOL)isAuthenticationSuccessPb:(FaceclawKitKotlinByteArray * _Nullable)pb magic:(int32_t)magic __attribute__((swift_name("isAuthenticationSuccess(pb:magic:)")));

/**
 * Display wake notification observed after a ring or right-arm double tap while no EvenHub
 * page is running:
 *
 * sid=0x0d, flag=notify, payload f1=1, f3={f1=1}
 *
 * Other state-change shapes (wear, charging, head-up, etc.) are deliberately excluded. The
 * caller additionally gates this on an intentional EvenHub suspension, so normal state
 * traffic cannot become application input.
 */
- (BOOL)isDisplayWakeStateChangeFrame:(FaceclawKitBleProtocolParsedFrame * _Nullable)frame __attribute__((swift_name("isDisplayWakeStateChange(frame:)")));

/** Decode the stock firmware's compass navigation notifications (sid 0x08). */
- (FaceclawKitBleProtocolCompassEvent * _Nullable)parseCompassEventFrame:(FaceclawKitBleProtocolParsedFrame * _Nullable)frame __attribute__((swift_name("parseCompassEvent(frame:)")));

/** MessageReceiver has already validated and removed the CRC. */
- (FaceclawKitBleProtocolCompassEvent * _Nullable)parseCompassPayloadSid:(int32_t)sid flag:(int32_t)flag root:(FaceclawKitKotlinByteArray *)root __attribute__((swift_name("parseCompassPayload(sid:flag:root:)")));

/**
 * Return the raw CFW ambient-light report from a sid-0x09 frame, or null when this is an
 * ordinary settings frame. Only the 65.toByte(),76.toByte(),version prelude is validated
 * here; the fields are decoded on the TS side.
 */
- (FaceclawKitKotlinByteArray * _Nullable)parseFaceclawAlsReportPb:(FaceclawKitKotlinByteArray * _Nullable)pb __attribute__((swift_name("parseFaceclawAlsReport(pb:)")));

/**
 * Decode a CFW field-102 idle-gesture event (tap, long press, release while no app is on
 * screen) into the EvenHub sys-event type and source the same gesture would carry from a
 * live page, or null when the frame is not one (ordinary settings frames and the double-tap
 * wake event included).
 */
- (FaceclawKitBleProtocolFaceclawGestureEvent * _Nullable)parseFaceclawGestureEventPb:(FaceclawKitKotlinByteArray * _Nullable)pb __attribute__((swift_name("parseFaceclawGestureEvent(pb:)")));

/**
 * Extract the CFW mic status record (field 104) from a settings frame, or null when absent.
 * The 21-byte body layout is decoded on the TS side; here we only validate the
 * 77.toByte(),67.toByte(),version prelude.
 */
- (FaceclawKitKotlinByteArray * _Nullable)parseFaceclawMicStatusPb:(FaceclawKitKotlinByteArray * _Nullable)pb __attribute__((swift_name("parseFaceclawMicStatus(pb:)")));

/**
 * Return the uint16 wake nonce from a CFW field-102 deferred-wake notification (double tap
 * or head-up), or -1 when this is an ordinary settings frame (idle-gesture events
 * included).
 */
- (int32_t)parseFaceclawWakeEventPb:(FaceclawKitKotlinByteArray *)pb __attribute__((swift_name("parseFaceclawWakeEvent(pb:)")));

/**
 * Which gesture a CFW deferred-wake notification reports: 1 (double tap) or
 * FACECLAW_WAKE_EVENT_HEAD_UP; -1 when the frame is not a wake event.
 */
- (int32_t)parseFaceclawWakeEventCodePb:(FaceclawKitKotlinByteArray *)pb __attribute__((swift_name("parseFaceclawWakeEventCode(pb:)")));
- (FaceclawKitBleProtocolParsedFrame *)parseFrameBuf:(FaceclawKitKotlinByteArray * _Nullable)buf __attribute__((swift_name("parseFrame(buf:)")));

/**
 * Decode a list-selection async event (sid=0xe0, flag=0x01/0x06). Returns null if the frame
 * is not a list event. `itemIndex` is 0-based into the ItemName array the list was built
 * with; `eventType` is EVENT_CLICK for a confirmed selection (scroll/highlight changes
 * arrive with other types).
 */
- (FaceclawKitBleProtocolListSelection * _Nullable)parseListSelectionFrame:(FaceclawKitBleProtocolParsedFrame *)frame __attribute__((swift_name("parseListSelection(frame:)")));

/** Field 106: RB/version 1/flags/percentage, from the CFW ring-battery cache. */
