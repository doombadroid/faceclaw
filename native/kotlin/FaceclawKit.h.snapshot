@end


/**
 * Ringing escalation. Each item starts silent on the phone (a notification only, the glasses do
 * the ringing) and escalates to phone sound when the glasses cannot carry it: not connected,
 * not on a head, charging, no delivery confirmation from the JS side within [DELIVERY_WAIT_MS],
 * or no acknowledgement within [ACK_WAIT_MS] of delivery. Sound stops after [AUTO_SILENCE_MS]
 * while the notification stays. The policy is process-wide; the platform host (a service on
 * Android) attaches its scheduler and sink while it is alive.
 */
__attribute__((objc_subclassing_restricted))
__attribute__((swift_name("AlarmRingingPolicy")))
@interface FaceclawKitAlarmRingingPolicy : FaceclawKitBase
- (instancetype)initWithGate:(FaceclawKitGlassesStatusGate *)gate clock:(FaceclawKitLong *(^)(void))clock platform:(id<FaceclawKitProtocolPlatform>)platform __attribute__((swift_name("init(gate:clock:platform:)"))) __attribute__((objc_designated_initializer));
@property (class, readonly, getter=companion) FaceclawKitAlarmRingingPolicyCompanion *companion __attribute__((swift_name("companion")));
- (void)attachScheduler:(id<FaceclawKitAlarmScheduler>)scheduler sink:(id<FaceclawKitRingingSink>)sink __attribute__((swift_name("attach(scheduler:sink:)")));
- (void)cancelTimers __attribute__((swift_name("cancelTimers()")));

/**
 * The glasses report showing [id]. True when the item is ringing (the host should process
 * the delivery); false when it is not yet known, in which case the signal is kept for a
 * ring request that follows within [EARLY_SIGNAL_MAX_AGE_MS].
 */
- (BOOL)deliveredOrDeferId:(int64_t)id __attribute__((swift_name("deliveredOrDefer(id:)")));
- (void)detach __attribute__((swift_name("detach()")));

/** Dismissed on the phone: journal it, stop it, and drop the schedule entry. */
- (void)dismissId:(int64_t)id __attribute__((swift_name("dismiss(id:)")));
- (BOOL)isAnythingRinging __attribute__((swift_name("isAnythingRinging()")));
- (BOOL)isRingingId:(int64_t)id __attribute__((swift_name("isRinging(id:)")));
- (void)markDeliveredId:(int64_t)id __attribute__((swift_name("markDelivered(id:)")));

/** An item came due (idempotent per id: a duplicate ring only refreshes the notification). */
- (void)ringItem:(FaceclawKitRingingItem *)item __attribute__((swift_name("ring(item:)")));
- (NSArray<FaceclawKitRingingItem *> *)snapshot __attribute__((swift_name("snapshot()")));

/** Snoozed on the phone: journal it, stop it, and re-arm on the phone directly so the snooze holds even with the JS side gone. */
- (void)snoozeId:(int64_t)id __attribute__((swift_name("snooze(id:)")));

/** As [deliveredOrDefer], for an acknowledgement / cancellation. */
- (BOOL)stopOrDeferId:(int64_t)id __attribute__((swift_name("stopOrDefer(id:)")));

/** Stop an item without a phone action (acknowledged on the glasses / cancelled by the engine). */
- (void)stopQuietlyId:(int64_t)id reason:(NSString *)reason __attribute__((swift_name("stopQuietly(id:reason:)")));

/** Start or stop the sound to match whether any escalated, not-yet-silenced item exists. */
- (void)syncSound __attribute__((swift_name("syncSound()")));
@end

__attribute__((objc_subclassing_restricted))
__attribute__((swift_name("AlarmRingingPolicy.Companion")))
@interface FaceclawKitAlarmRingingPolicyCompanion : FaceclawKitBase
+ (instancetype)alloc __attribute__((unavailable));
+ (instancetype)allocWithZone:(struct _NSZone *)zone __attribute__((unavailable));
+ (instancetype)companion __attribute__((swift_name("init()")));
@property (class, readonly, getter=shared) FaceclawKitAlarmRingingPolicyCompanion *shared __attribute__((swift_name("shared")));

/** How long after delivery to the glasses before the phone joins in. */
@property (readonly) int64_t ACK_WAIT_MS __attribute__((swift_name("ACK_WAIT_MS")));

/** Sound and vibration stop after this; the notification stays. */
@property (readonly) int64_t AUTO_SILENCE_MS __attribute__((swift_name("AUTO_SILENCE_MS")));

/** How long to wait for the JS side to confirm the glasses are showing the item. */
@property (readonly) int64_t DELIVERY_WAIT_MS __attribute__((swift_name("DELIVERY_WAIT_MS")));
@property (readonly) int64_t EARLY_SIGNAL_MAX_AGE_MS __attribute__((swift_name("EARLY_SIGNAL_MAX_AGE_MS")));
@end


/**
 * The persisted alarm schedule, the phone-action journal and the diagnostics log, plus the
 * replay / staleness policies. Everything the platform's alarm clock API does not own.
 * Compound read-modify-write operations are serialized on one lock; the store itself only
 * needs to be atomic per key.
 */
__attribute__((objc_subclassing_restricted))
__attribute__((swift_name("AlarmSchedule")))
@interface FaceclawKitAlarmSchedule : FaceclawKitBase
- (instancetype)initWithStore:(id<FaceclawKitAlarmStore>)store clock:(FaceclawKitLong *(^)(void))clock platform:(id<FaceclawKitProtocolPlatform>)platform __attribute__((swift_name("init(store:clock:platform:)"))) __attribute__((objc_designated_initializer));
@property (class, readonly, getter=companion) FaceclawKitAlarmScheduleCompanion *companion __attribute__((swift_name("companion")));
- (void)appendJournalId:(int64_t)id action:(NSString *)action minutes:(int32_t)minutes __attribute__((swift_name("appendJournal(id:action:minutes:)")));

/** Hand the journal over as a JSON array and clear it. */
- (NSString *)drainJournal __attribute__((swift_name("drainJournal()")));

/** All entries, in stored order. */
- (NSArray<FaceclawKitAlarmEntry *> *)entries __attribute__((swift_name("entries()")));
- (FaceclawKitAlarmEntry * _Nullable)findId:(int64_t)id __attribute__((swift_name("find(id:)")));
- (void)logLine:(NSString *)line __attribute__((swift_name("log(line:)")));

/**
 * The schedule and the system alarm clock can disagree (a force-stop clears alarms but not
 * the file). True when the soonest stored entry is not what the system reports as its next
 * alarm clock; another app's sooner alarm is fine, only a later (or absent) one proves ours
 * is missing. [systemNextAlarmAt] is null when the system has no alarm clock set.
 */
- (BOOL)looksStaleSystemNextAlarmAt:(FaceclawKitLong * _Nullable)systemNextAlarmAt now:(int64_t)now __attribute__((swift_name("looksStale(systemNextAlarmAt:now:)")));

/** Add or replace the entry with the same id (moved to the end). */
- (void)putEntry:(FaceclawKitAlarmEntry *)entry __attribute__((swift_name("put(entry:)")));
- (NSString *)readLog __attribute__((swift_name("readLog()")));
- (void)removeId:(int64_t)id __attribute__((swift_name("remove(id:)")));

/**
 * Replay the schedule after a reboot, package update or clock change: entries already due
 * ring now if inside the grace window, older ones are dropped as missed (and logged), the
 * rest are handed to [arm]. Logs the outcome.
 */
- (void)replayReason:(NSString * _Nullable)reason ring:(void (^)(FaceclawKitAlarmEntry *))ring arm:(void (^)(FaceclawKitAlarmEntry *))arm __attribute__((swift_name("replay(reason:ring:arm:)")));

/** The soonest future trigger time, or null when nothing is pending. */
- (FaceclawKitLong * _Nullable)soonestPendingAtNow:(int64_t)now __attribute__((swift_name("soonestPendingAt(now:)")));
@end

__attribute__((objc_subclassing_restricted))
__attribute__((swift_name("AlarmSchedule.Companion")))
@interface FaceclawKitAlarmScheduleCompanion : FaceclawKitBase
+ (instancetype)alloc __attribute__((unavailable));
+ (instancetype)allocWithZone:(struct _NSZone *)zone __attribute__((unavailable));
+ (instancetype)companion __attribute__((swift_name("init()")));
@property (class, readonly, getter=shared) FaceclawKitAlarmScheduleCompanion *shared __attribute__((swift_name("shared")));

/** A stable per-item request code for platform alarm/notification identities. */
- (int32_t)requestCodeId:(int64_t)id __attribute__((swift_name("requestCode(id:)")));
@property (readonly) NSString *KEY_JOURNAL __attribute__((swift_name("KEY_JOURNAL")));
@property (readonly) NSString *KEY_LOG __attribute__((swift_name("KEY_LOG")));
@property (readonly) NSString *KEY_SCHEDULED __attribute__((swift_name("KEY_SCHEDULED")));
@property (readonly) NSString *KIND_ALARM __attribute__((swift_name("KIND_ALARM")));
@property (readonly) NSString *KIND_TIMER __attribute__((swift_name("KIND_TIMER")));

/**
 * A schedule entry found already past due (after a reboot, or when the process was
 * asleep) rings if it is at most this late; older ones are dropped as missed. Matches
 * the JS engine's grace window.
 */
@property (readonly) int64_t LATE_GRACE_MS __attribute__((swift_name("LATE_GRACE_MS")));
@property (readonly) int32_t LOG_LINES __attribute__((swift_name("LOG_LINES")));
@end


/** Delayed callbacks for the escalation timers; the owner's main thread on Android. */
__attribute__((swift_name("AlarmScheduler")))
@protocol FaceclawKitAlarmScheduler
@required
- (void)cancelToken:(id)token __attribute__((swift_name("cancel(token:)")));
- (void)cancelAll __attribute__((swift_name("cancelAll()")));
- (void)postDelayedToken:(id)token delayMs:(int64_t)delayMs action:(void (^)(void))action __attribute__((swift_name("postDelayed(token:delayMs:action:)")));
@end


/** Key/value persistence for the alarm schedule, journal and log (device-protected prefs on Android). */
__attribute__((swift_name("AlarmStore")))
@protocol FaceclawKitAlarmStore
@required
- (NSString * _Nullable)readKey:(NSString *)key __attribute__((swift_name("read(key:)")));
- (void)writeKey:(NSString *)key value:(NSString * _Nullable)value __attribute__((swift_name("write(key:value:)")));
@end


