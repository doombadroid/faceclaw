- (void)setUsePhoneMicUsePhoneMic:(BOOL)usePhoneMic __attribute__((swift_name("setUsePhoneMic(usePhoneMic:)")));
- (void)startRequestedMode:(NSString * _Nullable)requestedMode __attribute__((swift_name("start(requestedMode:)")));
- (void)startRequestedMode:(NSString * _Nullable)requestedMode captureId:(int32_t)captureId __attribute__((swift_name("start(requestedMode:captureId:)")));

/**
 * Stops the session and waits up to 1.5 s for the worker to finish unless
 * called from the worker itself. The worker checks the stop flag between
 * packets (every packet or 250 ms wait) and between phone-mic reads (50 ms).
 */
