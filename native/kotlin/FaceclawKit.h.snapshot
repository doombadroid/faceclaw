 * (the selectable rows) in one page. Uses stock-firmware-safe geometry (each container
 * within the stock ~280x130 container-size cap; the CFW is what lifts that to 576x288), so
 * this works before flashing. The selected row comes back as an async list event — see
 * parseListSelection.
 */
- (FaceclawKitKotlinByteArray *)buildCreatePromptPageMagic:(int32_t)magic textName:(NSString *)textName textContainerId:(int32_t)textContainerId warningText:(NSString *)warningText listName:(NSString *)listName listContainerId:(int32_t)listContainerId items:(FaceclawKitKotlinArray<NSString *> *)items __attribute__((swift_name("buildCreatePromptPage(magic:textName:textContainerId:warningText:listName:listContainerId:items:)")));
- (FaceclawKitKotlinByteArray *)buildDashboardTextUpgradeMagic:(int32_t)magic __attribute__((swift_name("buildDashboardTextUpgrade(magic:)")));

/**
 * Wrap an already-encoded [77.toByte(),67.toByte(),ver,op,...] mic-control record as a
 * settings write carrying CFW field 103. Magic zero makes it fire-and-forget like the wake
 * lease: the firmware consumes the field before its stock nanopb decoder discards the
 * unknown tag, and the "ack" is the field-104 status notify that follows.
 */
- (FaceclawKitKotlinByteArray *)buildFaceclawMicControlRecord:(FaceclawKitKotlinByteArray *)record __attribute__((swift_name("buildFaceclawMicControl(record:)")));

/**
 * Build the CFW-only wake lease control package. Magic zero deliberately makes this
 * fire-and-forget: the firmware consumes field 101 before its stock nanopb decoder discards
 * the unknown field.
 */
- (FaceclawKitKotlinByteArray *)buildFaceclawWakeControlOperation:(int32_t)operation nonce:(int32_t)nonce __attribute__((swift_name("buildFaceclawWakeControl(operation:nonce:)")));
- (FaceclawKitKotlinByteArray *)buildHeartbeatMagic:(int32_t)magic __attribute__((swift_name("buildHeartbeat(magic:)")));
