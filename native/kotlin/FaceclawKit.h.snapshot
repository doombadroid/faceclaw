/**
 * Scales one decoded video frame's luma plane into an 8bpp gray rect for a compositor surface:
 * a box filter (averaging up to [MAX_TAPS] x [MAX_TAPS] evenly spaced samples per output pixel,
 * nearest-neighbor when upscaling), then the container's display rotation, then a tone lookup.
 *
 * Only luma is read: the glasses show gray, and Y is exactly the gray a decoder hands back
 * without any color conversion. Platform code owns decoding and copies the plane into a
 * ByteArray; this class owns the pixel math. One instance serves one (source size, rotation,
 * output size) combination and reuses its scratch buffers across frames; not thread-safe.
 */
__attribute__((objc_subclassing_restricted))
__attribute__((swift_name("VideoFrameScaler")))
@interface FaceclawKitVideoFrameScaler : FaceclawKitBase
- (instancetype)initWithSourceWidth:(int32_t)sourceWidth sourceHeight:(int32_t)sourceHeight rotation:(int32_t)rotation outputWidth:(int32_t)outputWidth outputHeight:(int32_t)outputHeight __attribute__((swift_name("init(sourceWidth:sourceHeight:rotation:outputWidth:outputHeight:)"))) __attribute__((objc_designated_initializer));
@property (class, readonly, getter=companion) FaceclawKitVideoFrameScalerCompanion *companion __attribute__((swift_name("companion")));

/**
 * Scale the luma plane into [out] (outputWidth * outputHeight bytes, row-major). The visible
 * pixel (x, y) is at luma[offset + y * rowStride + x * pixelStride]; [lut] is a 256-entry
 * table from [toneLut].
 */
- (void)scaleLuma:(FaceclawKitKotlinByteArray *)luma offset:(int32_t)offset rowStride:(int32_t)rowStride pixelStride:(int32_t)pixelStride lut:(FaceclawKitKotlinByteArray *)lut out:(FaceclawKitKotlinByteArray *)out __attribute__((swift_name("scale(luma:offset:rowStride:pixelStride:lut:out:)")));
@property (readonly) int32_t outputHeight __attribute__((swift_name("outputHeight")));

/** Output size in display orientation. */
@property (readonly) int32_t outputWidth __attribute__((swift_name("outputWidth")));

/** Clockwise display rotation in degrees: 0, 90, 180 or 270. */
@property (readonly) int32_t rotation __attribute__((swift_name("rotation")));
@property (readonly) int32_t sourceHeight __attribute__((swift_name("sourceHeight")));

/** Visible luma size in coded (unrotated) orientation. */
@property (readonly) int32_t sourceWidth __attribute__((swift_name("sourceWidth")));
@end

__attribute__((objc_subclassing_restricted))
__attribute__((swift_name("VideoFrameScaler.Companion")))
@interface FaceclawKitVideoFrameScalerCompanion : FaceclawKitBase
+ (instancetype)alloc __attribute__((unavailable));
+ (instancetype)allocWithZone:(struct _NSZone *)zone __attribute__((unavailable));
+ (instancetype)companion __attribute__((swift_name("init()")));
@property (class, readonly, getter=shared) FaceclawKitVideoFrameScalerCompanion *shared __attribute__((swift_name("shared")));

/** Snap any angle to the nearest of 0/90/180/270, the only rotations containers use. */
- (int32_t)normalizeRotationDegrees:(int32_t)degrees __attribute__((swift_name("normalizeRotation(degrees:)")));

/**
 * Luma to display gray. Limited ("TV") range video codes black at 16 and white at 235, so
 * it is stretched to 0..255 first. Monochrome thresholds at mid-gray to 0 or 255 (a
 * 1-bit image compresses and delta-encodes far better than 16 levels); otherwise the
 * gamma curve applies, as for photos (see GrayPacket.fromArgb).
 */
- (FaceclawKitKotlinByteArray *)toneLutLimitedRange:(BOOL)limitedRange gamma:(float)gamma monochrome:(BOOL)monochrome __attribute__((swift_name("toneLut(limitedRange:gamma:monochrome:)")));

/** Most samples averaged along each axis per output pixel; bounds work for big downscales. */
@property (readonly) int32_t MAX_TAPS __attribute__((swift_name("MAX_TAPS")));
@end


