/**
 * Spectral suppression for PCM from glasses microphones: 16 ms sqrt-Hann frames at 50% overlap,
 * asymmetric noise-floor tracking and a smoothed Wiener gain. Android capture-session effects live
 * in AndroidNoiseEffects. This processor has no platform dependencies and must be owned by a single
 * audio worker.
 */
__attribute__((objc_subclassing_restricted))
__attribute__((swift_name("FaceclawNoiseSuppressor")))
@interface FaceclawKitFaceclawNoiseSuppressor : FaceclawKitBase
- (instancetype)initWithSampleRate:(int32_t)sampleRate __attribute__((swift_name("init(sampleRate:)"))) __attribute__((objc_designated_initializer));
@property (class, readonly, getter=companion) FaceclawKitFaceclawNoiseSuppressorCompanion *companion __attribute__((swift_name("companion")));
- (int32_t)getSampleRate __attribute__((swift_name("getSampleRate()")));

/**
 * Suppress noise in 16-bit little-endian mono PCM. Streaming: input not filling a whole 8 ms
 * hop is carried into the next call, so the output may be up to one hop shorter than the input
 * (and longer on a later call); total latency is one hop.
 */
- (FaceclawKitKotlinByteArray * _Nullable)processPcm16le:(FaceclawKitKotlinByteArray * _Nullable)pcm16le __attribute__((swift_name("process(pcm16le:)")));

/** Forget the learned noise floor (e.g. after the suppressor was toggled off). */
- (void)reset __attribute__((swift_name("reset()")));
@end

__attribute__((objc_subclassing_restricted))
__attribute__((swift_name("FaceclawNoiseSuppressor.Companion")))
@interface FaceclawKitFaceclawNoiseSuppressorCompanion : FaceclawKitBase
+ (instancetype)alloc __attribute__((unavailable));
+ (instancetype)allocWithZone:(struct _NSZone *)zone __attribute__((unavailable));
+ (instancetype)companion __attribute__((swift_name("init()")));
@property (class, readonly, getter=shared) FaceclawKitFaceclawNoiseSuppressorCompanion *shared __attribute__((swift_name("shared")));
@end

